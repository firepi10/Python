[Unit]
Description=Bayta family hub backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bayta
Group=bayta
WorkingDirectory=/opt/bayta/current/backend
Environment=BAYTA_DATA_DIR=/var/lib/bayta
EnvironmentFile=-/etc/bayta/bayta.env
ExecStart=/opt/bayta/current/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80 --workers 1
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/bayta
PrivateTmp=true

[Install]
WantedBy=multi-user.target
